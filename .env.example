# ── Root environment example (copy to .env) ────────────────────────────

# PostgreSQL
POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=taskmaster
POSTGRES_DB=taskmaster
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# Web (para construir links de invitación)
WEB_URL=http://localhost:5173

# Auth (generar secret con: openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=TaskMaster <onboarding@taskmaster.app>

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA (Gemini) — key gratuita desde aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_DAILY_LIMIT=15
