# ── Root environment example (copy to .env) ────────────────────────────

# PostgreSQL
POSTGRES_USER=taskmaster
POSTGRES_PASSWORD=taskmaster
POSTGRES_DB=taskmaster
POSTGRES_PORT=5432

# Redis
# Estado compartido entre réplicas de la API: rate limit, bloqueo de cuenta por
# intentos fallidos y cuota diaria de IA. La API valida la conexión al arrancar y
# NO levanta si Redis no responde (`docker compose up -d redis`). Si más
# adelante Redis se cae, la API sigue sirviendo con los contadores en memoria
# (degradación visible en /health), así que no es una dependencia de red dura.
# REDIS_HOST                en docker-compose: "redis", en local: localhost
# REDIS_PORT                puerto del servicio
# REDIS_PASSWORD            solo si el Redis está autenticado (producción)
# REDIS_DB                  base lógica, para separar entornos en un mismo Redis
# REDIS_KEY_PREFIX          prefijo de todas las keys
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=taskmaster

# API
NODE_ENV=development
API_PORT=4000
API_URL=http://localhost:4000

# CORS — dominios del frontend, separados por coma.
# OBLIGATORIO en todos los entornos: la app no arranca si falta o si deja el CORS abierto
# (expone /auth/login y /workspaces/invites/:token). Sin default: configurá tu dominio.
# API_ORIGINS=https://app.taskmaster.app,https://admin.taskmaster.app
API_ORIGINS=

# Número de proxies delante de la API. 0 = ninguno (default, directo).
# Subilo solo si hay un reverse proxy (Caddy/Nginx): define qué entrada de
# X-Forwarded-For se toma como IP real, y de eso depende el rate limit.
# Con 1 proxy (Caddy) usá 1. Nunca pongas más que la cantidad real de saltos.
TRUST_PROXY=0

# Web (para construir links de invitación)
WEB_URL=http://localhost:5173

# Auth (generar secret con: openssl rand -base64 32)
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Bloqueo de cuenta por intentos fallidos de login.
# El throttler frena por IP y por email hasheado en una ventana corta; esto frena
# la cuenta cuando los intentos llegan desde muchas IPs a la vez (credential
# stuffing distribuido), que es lo que el throttler no ve.
# LOGIN_MAX_FAILURES          intentos fallidos dentro de la ventana antes de bloquear
# LOGIN_FAIL_WINDOW_SECONDS   ventana de conteo, en segundos
# LOGIN_LOCK_SECONDS          duración del bloqueo, en segundos
LOGIN_MAX_FAILURES=5
LOGIN_FAIL_WINDOW_SECONDS=900
LOGIN_LOCK_SECONDS=900

# Email (Resend)
RESEND_API_KEY=
MAIL_FROM=TaskMaster <onboarding@taskmaster.app>

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# IA (Gemini) — key gratuita desde aistudio.google.com -> Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_DAILY_LIMIT=15

# Opt-in para el test de integración contra la API real de Gemini
# (ai.integration.spec.ts). Con la key sola el test se salta: hace falta
# RUN_AI_INTEGRATION=1 para que una `pnpm test` local le pegue a la API de pago.
RUN_AI_INTEGRATION=0

# Login con Google — opcional. Las tres se llenan juntas o se dejan vacías:
# con la mitad, la app no arranca y avisa qué falta.
#
# Crear credenciales en https://console.cloud.google.com/apis/credentials
# -> "OAuth client ID" -> tipo "Web application".
#
# En "Authorized redirect URIs" va EXACTAMENTE el mismo valor que
# GOOGLE_REDIRECT_URI. OJO con el puerto: es el del FRONT (5173 en dev), no el
# de la API. El front tiene un proxy de /api hacia la API, y el redirect tiene
# que volver por el mismo origen donde el navegador guardó la cookie `state`;
# si vuelve al puerto de la API, la cookie no está y el login falla siempre.
#   dev:  http://localhost:5173/api/auth/oauth/google/callback
#   prod: https://tu-dominio/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
