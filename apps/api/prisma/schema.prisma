// TaskMaster Prisma schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum SystemRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum NoteType {
  STANDARD
  CHECKLIST
  IDEA
  MEETING
  STICKY
}

enum StickyColor {
  YELLOW
  PINK
  BLUE
  GREEN
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum DependencyType {
  BLOCKS
  BLOCKED_BY
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTI_SELECT
  CHECKBOX
}

// ── Dream Board ───────────────────────────────────────────────────────

enum DreamPinType {
  GOAL
  PROJECT
  LEARNING
  TRAVEL
  FINANCIAL
  HEALTH
}

// Paleta fija del tablero: seis colores, los mismos del selector en la UI.
enum DreamPinColor {
  AMBER
  ROSE
  SKY
  EMERALD
  VIOLET
  SLATE
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  // Token de un solo uso que intercambia el frontend por una sesión después de un
  // callback OAuth. Existe para que el access token nunca viaje en la URL: la
  // redirección de Google vuelve al navegador con este token y el frontend lo
  // canjea por la sesión en un POST.
  OAUTH_HANDOFF
}

// ── Users & Auth ──────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  name            String
  avatarUrl       String?
  role            SystemRole @default(USER)
  // Nullable a propósito: una cuenta creada con Google no tiene contraseña. El
  // login con password la trata como "no verificable" en vez de romper, y
  // `change-password` deja que ese usuario se ponga una contraseña por primera vez.
  passwordHash    String?
  isEmailVerified Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  accounts        Account[]
  settings        UserSettings?
  ownedWorkspaces Workspace[]        @relation("OwnedWorkspaces")
  workspaces      WorkspaceMember[]
  createdTasks    Task[]             @relation("Creator")
  authoredNotes   Note[]             @relation("Author")
  reminders       Reminder[]
  notifications   Notification[]
  refreshTokens   RefreshToken[]
  authTokens      AuthToken[]
  activities      ActivityLog[]
  comments        Comment[]
  assignedTasks   TaskAssignee[]
  noteCollab      NoteCollaborator[]
  savedViews      SavedView[]
  attachments     Attachment[]
  taskTemplates   TaskTemplate[]
  timeEntries     TimeEntry[]
  invitedMembers  Invite[]           @relation("InvitedBy")
  aiGenerations   AiGeneration[]
  aiChatEntries   AiChatEntry[]
  dreamPins       DreamPin[]         @relation("DreamPinAuthor")
}

/// Identidad federada: una misma persona puede entrar por Google y por
/// contraseña dentro de la misma cuenta de Taskmaster.
///
/// Genérico a propósito (`provider` es texto, no enum) para que sumar GitHub o
/// Microsoft no requiera migración. Solo hay un provider implementado; el modelo
/// lo primero para no atar el schema a Google.
model Account {
  id String @id @default(cuid())

  /// Discriminante del proveedor: "google", "github", ...
  provider String

  /// Identificador estable del usuario dentro del proveedor (el `sub` de Google).
  /// Nunca es el email: los proveedores permiten cambiarlo y reutilizar el email.
  providerAccountId String

  /// Email que tenía la cuenta en el proveedor al momento de vincularlo. Se guarda
  /// solo como evidencia; la fuente de verdad del email es `User.email`.
  emailAtLinkTime String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Un proveedor + providerAccountId identifica a una persona de forma única y
  // global: sin este índice, dos requests con el mismo `sub` podrían crear dos
  // cuentas en paralelo y dejar la segunda colgada.
  @@unique([provider, providerAccountId])
  @@index([userId])
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  device     String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
}

model UserSettings {
  userId       String  @id
  theme        String  @default("system")
  language     String  @default("es")
  defaultView  String  @default("tasks")
  weeklyDigest Boolean @default(false)
  emailPrefs   Json    @default("{}")
  timezone     String  @default("America/Bogota")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Workspaces & membership ───────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  ownerId   String
  createdAt DateTime @default(now())

  owner             User                    @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members           WorkspaceMember[]
  teams             Team[]
  permissionGroups  PermissionGroup[]
  tasks             Task[]
  notes             Note[]
  tags              Tag[]
  channels          Channel[]
  reminders         Reminder[]
  activities        ActivityLog[]
  invites           Invite[]
  notifications     Notification[]
  savedViews        SavedView[]
  attachments       Attachment[]
  taskDependencies  TaskDependency[]
  taskTemplates     TaskTemplate[]
  timeEntries       TimeEntry[]
  customFieldDefs   CustomFieldDefinition[]
  customFieldValues CustomFieldValue[]
  aiGenerations     AiGeneration[]
  aiChatEntries     AiChatEntry[]
  dreamBoard        DreamBoard?
  dreamPins         DreamPin[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  permissionGroupMembers PermissionGroupMember[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  // El token en claro solo viaja por email. En la DB queda el hash: un dump no
  // debe permitir redimir invitaciones.
  tokenHash   String        @unique
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([email])
}

// ── Tasks ─────────────────────────────────────────────────────────────

model Task {
  id              String     @id @default(cuid())
  workspaceId     String
  creatorId       String
  title           String
  description     String     @default("")
  status          TaskStatus @default(TODO)
  priority        Priority   @default(MEDIUM)
  dueDate         DateTime?
  startDate       DateTime?
  order           Float      @default(0)
  parentId        String?
  channelId       String?
  isRecurring     Boolean    @default(false)
  recurrence      Json?
  completedAt     DateTime?
  dueSoNotifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User             @relation("Creator", fields: [creatorId], references: [id])
  parent      Task?            @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Task[]           @relation("Subtasks")
  channel     Channel?         @relation(fields: [channelId], references: [id], onDelete: SetNull)
  tags        TaskTag[]
  assignees   TaskAssignee[]
  comments    Comment[]
  reminders   Reminder[]
  attachments Attachment[]
  blocking    TaskDependency[] @relation("BlockingTasks")
  blockedBy   TaskDependency[] @relation("BlockedByTasks")
  timeEntries TimeEntry[]
  dreamPins   DreamPin[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, dueDate])
  @@index([workspaceId, completedAt])
  @@index([workspaceId, createdAt])
  @@index([dueDate, dueSoNotifiedAt])
  @@index([parentId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Channel {
  id          String   @id @default(cuid())
  workspaceId String
  teamId      String?
  name        String
  description String   @default("")
  isPrivate   Boolean  @default(false)
  color       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  team      Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@unique([workspaceId, name])
  @@index([workspaceId, teamId])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id               String   @id @default(cuid())
  taskId           String
  userId           String
  body             String
  mentionedUserIds String   @default("[]")
  createdAt        DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ── Notes ─────────────────────────────────────────────────────────────

model Note {
  id          String       @id @default(cuid())
  workspaceId String
  authorId    String
  type        NoteType     @default(STANDARD)
  title       String?
  content     String?
  color       StickyColor?
  pinned      Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User               @relation("Author", fields: [authorId], references: [id])
  tags          NoteTag[]
  items         ChecklistItem[]
  collaborators NoteCollaborator[]
  reminders     Reminder[]
  attachments   Attachment[]

  @@index([workspaceId, pinned])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  noteId String
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model NoteTag {
  id     String  @id @default(cuid())
  noteId String
  name   String
  color  String?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, name])
}

model NoteCollaborator {
  noteId String
  userId String
  role   String @default("EDITOR")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
}

// ── Reminders & notifications ─────────────────────────────────────────

model Reminder {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  taskId      String?
  noteId      String?
  title       String
  triggerAt   DateTime
  sentAt      DateTime?
  repeat      ReminderRepeat @default(NONE)
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, triggerAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ── Activity & files ──────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  entityType  String
  entityId    String
  action      String
  changes     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
}

// ── Saved views ───────────────────────────────────────────────────────

model SavedView {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  filters     Json     @default("{}")
  view        String   @default("cards")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId])
}

// ── Attachments ───────────────────────────────────────────────────────

model Attachment {
  id          String   @id @default(cuid())
  workspaceId String
  taskId      String?
  noteId      String?
  userId      String
  fileName    String
  mimeType    String
  fileSize    Int
  url         String
  publicId    String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@index([workspaceId, noteId])
}

// ── Task Dependencies ────────────────────────────────────────────────

model TaskDependency {
  id          String   @id @default(cuid())
  workspaceId String
  fromTaskId  String
  toTaskId    String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  fromTask  Task      @relation("BlockingTasks", fields: [fromTaskId], references: [id], onDelete: Cascade)
  toTask    Task      @relation("BlockedByTasks", fields: [toTaskId], references: [id], onDelete: Cascade)

  @@unique([fromTaskId, toTaskId])
  @@index([workspaceId])
  @@index([fromTaskId])
  @@index([toTaskId])
}

// ── Task Templates ───────────────────────────────────────────────────

model TaskTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  name        String
  description String   @default("")
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId, name])
  @@index([workspaceId, userId])
}

// ── Time Tracking ────────────────────────────────────────────────────

model TimeEntry {
  id          String    @id @default(cuid())
  workspaceId String
  taskId      String
  userId      String
  description String    @default("")
  startedAt   DateTime
  stoppedAt   DateTime?
  duration    Int?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId])
  @@index([workspaceId, userId])
  @@index([workspaceId, startedAt])
}

// ── Custom Fields ────────────────────────────────────────────────────

model CustomFieldDefinition {
  id          String          @id @default(cuid())
  workspaceId String
  name        String
  type        CustomFieldType
  options     Json?
  order       Float           @default(0)
  required    Boolean         @default(false)
  createdAt   DateTime        @default(now())

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  values    CustomFieldValue[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model CustomFieldValue {
  id           String   @id @default(cuid())
  workspaceId  String
  definitionId String
  entityId     String
  entityType   String
  value        Json
  createdAt    DateTime @default(now())

  workspace  Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([definitionId, entityId])
  @@index([workspaceId, entityId, entityType])
  @@index([workspaceId, definitionId])
}

// ── Dream Board ──────────────────────────────────────────────────────

// Un tablero por workspace. Los pins guardan su posición absoluta en el
// corcho (px) para que el drag & drop sobreviva a recargas.
model DreamBoard {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  title       String   @default("Mi Tablero de Sueños")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  pins      DreamPin[]
}

model DreamPin {
  id           String        @id @default(cuid())
  workspaceId  String
  boardId      String
  title        String
  description  String        @default("")
  type         DreamPinType  @default(GOAL)
  color        DreamPinColor @default(AMBER)
  x            Float         @default(0)
  y            Float         @default(0)
  imageUrl     String?
  // `public_id` de Cloudinary del asset de `imageUrl`. Guardarlo evita derivar
  // el id desde la URL al borrar el pin (y funciona igual si la URL cambia de
  // formato). Es null en imágenes `data:` (sin Cloudinary) y en pins viejos.
  imagePublicId String?
  sticker      String?
  linkedTaskId String?
  // Autor del pin: solo él (o un admin del workspace) puede editarlo o borrarlo.
  createdById  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  workspace  Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  board      DreamBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("DreamPinAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  linkedTask Task?      @relation(fields: [linkedTaskId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([boardId, createdAt])
  @@index([createdById])
  @@index([linkedTaskId])
}

// ── AI usage log ────────────────────────────────────────────────────

model AiGeneration {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  feature     String
  provider    String   @default("gemini")
  model       String
  status      String   @default("success")
  latencyMs   Int?
  inputChars  Int?
  outputChars Int?
  error       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([userId, createdAt])
}

// ── AI assistant chat persistence ───────────────────────────────────

/// Historial del asistente IA. Antes vivía solo en `useState` del frontend y
/// se perdía al recargar. `actions` guarda las acciones locales que el guion
/// del asistente aplicó (p. ej. crear tarea), para poder reconstruir la UI.
model AiChatEntry {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  role        String
  text        String
  actions     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, userId, createdAt])
}

model Team {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String   @default("")
  color       String   @default("#3b82f6")
  avatar      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  teamMembers TeamMember[]
  channels    Channel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model TeamMember {
  id                String   @id @default(cuid())
  teamId            String
  workspaceMemberId String
  createdAt         DateTime @default(now())

  team            Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([teamId, workspaceMemberId])
  @@index([workspaceMemberId])
}

// ── Permission groups ───────────────────────────────────────────────

/// Grupo de permisos: asigna un rol del workspace a sus miembros.
///
/// El rol efectivo de un miembro es el máximo entre su rol propio y los roles
/// de sus grupos (`WorkspaceAccessService`), así que un grupo puede ampliar
/// capacidades sin cambiar el rol base. No puede existir en un workspace sin
/// ese owner: los grupos se crean/gestionan desde el backend con
/// `assertWriteRole`.
model PermissionGroup {
  id          String        @id @default(cuid())
  workspaceId String
  name        String
  description String        @default("")
  color       String        @default("#6366f1")
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  workspace Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members   PermissionGroupMember[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PermissionGroupMember {
  id                String   @id @default(cuid())
  groupId           String
  workspaceMemberId String
  createdAt         DateTime @default(now())

  group           PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  workspaceMember WorkspaceMember @relation(fields: [workspaceMemberId], references: [id], onDelete: Cascade)

  @@unique([groupId, workspaceMemberId])
  @@index([workspaceMemberId])
}
