// TaskMaster Prisma schema
// PostgreSQL via Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────

enum SystemRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
  ARCHIVED
}

enum NoteType {
  STANDARD
  CHECKLIST
  IDEA
  MEETING
  STICKY
}

enum StickyColor {
  YELLOW
  PINK
  BLUE
  GREEN
}

enum ReminderRepeat {
  NONE
  DAILY
  WEEKLY
  MONTHLY
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

// ── Users & Auth ──────────────────────────────────────────────────────

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  passwordHash    String
  name            String
  avatarUrl       String?
  role            SystemRole  @default(USER)
  isEmailVerified Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  settings       UserSettings?
  ownedWorkspaces Workspace[]  @relation("OwnedWorkspaces")
  workspaces     WorkspaceMember[]
  createdTasks   Task[]            @relation("Creator")
  authoredNotes  Note[]            @relation("Author")
  reminders      Reminder[]
  notifications  Notification[]
  refreshTokens  RefreshToken[]
  activities     ActivityLog[]
  comments       Comment[]
  assignedTasks  TaskAssignee[]
  noteCollab     NoteCollaborator[]
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  device     String?
  ip         String?
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedBy String?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  userId       String  @id
  theme        String  @default("system")
  language     String  @default("es")
  defaultView  String  @default("tasks")
  weeklyDigest Boolean @default(false)
  emailPrefs   Json    @default("{}")
  timezone     String  @default("America/Bogota")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Workspaces & membership ───────────────────────────────────────────

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String?
  ownerId   String
  createdAt DateTime @default(now())

  owner      User              @relation("OwnedWorkspaces", fields: [ownerId], references: [id], onDelete: Cascade)
  members    WorkspaceMember[]
  tasks      Task[]
  notes      Note[]
  tags       Tag[]
  categories Category[]
  reminders  Reminder[]
  activities ActivityLog[]
  invites    Invite[]

  @@index([ownerId])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Invite {
  id          String        @id @default(cuid())
  workspaceId String
  email       String
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ── Tasks ─────────────────────────────────────────────────────────────

model Task {
  id          String     @id @default(cuid())
  workspaceId String
  creatorId   String
  title       String
  description String     @default("")
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?
  startDate   DateTime?
  order       Float      @default(0)
  parentId    String?
  categoryId  String?
  isRecurring Boolean    @default(false)
  recurrence  Json?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace  Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator    User         @relation("Creator", fields: [creatorId], references: [id])
  parent     Task?        @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks   Task[]       @relation("Subtasks")
  category   Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tags       TaskTag[]
  assignees  TaskAssignee[]
  comments   Comment[]
  reminders  Reminder[]

  @@index([workspaceId, status])
  @@index([workspaceId, priority])
  @@index([workspaceId, dueDate])
  @@index([parentId])
}

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     TaskTag[]

  @@unique([workspaceId, name])
}

model TaskTag {
  taskId String
  tagId  String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
}

model Category {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([workspaceId, name])
}

model TaskAssignee {
  taskId String
  userId String
  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ── Notes ─────────────────────────────────────────────────────────────

model Note {
  id          String     @id @default(cuid())
  workspaceId String
  authorId    String
  type        NoteType   @default(STANDARD)
  title       String?
  content     String?
  color       StickyColor?
  pinned      Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author        User               @relation("Author", fields: [authorId], references: [id])
  tags          NoteTag[]
  items         ChecklistItem[]
  collaborators NoteCollaborator[]
  reminders     Reminder[]

  @@index([workspaceId, pinned])
}

model ChecklistItem {
  id     String  @id @default(cuid())
  noteId String
  text   String
  done   Boolean @default(false)
  order  Int     @default(0)

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId])
}

model NoteTag {
  id     String @id @default(cuid())
  noteId String
  name   String
  color  String?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@unique([noteId, name])
}

model NoteCollaborator {
  noteId String
  userId String
  role   String @default("EDITOR")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([noteId, userId])
}

// ── Reminders & notifications ─────────────────────────────────────────

model Reminder {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  taskId      String?
  noteId      String?
  title       String
  triggerAt   DateTime
  sentAt      DateTime?
  repeat      ReminderRepeat @default(NONE)
  createdAt   DateTime       @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note      Note?     @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([workspaceId, triggerAt])
}

model Notification {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  type        String
  title       String
  body        String?
  data        Json?
  readAt      DateTime?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

// ── Activity & files ──────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  entityType  String
  entityId    String
  action      String
  changes     Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, createdAt])
}
